#!/usr/bin/env bash

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SKILL_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

API_PORT=6868
if ! nc -z localhost $API_PORT 2>/dev/null; then
  echo "API Server is down. Starting it now..."
  (cd "$SKILL_DIR" && nohup node "$SCRIPT_DIR/server.js" > /tmp/aic-server.log 2>&1 &)
  sleep 2
fi

set -euo pipefail

AIC_DIR="$SKILL_DIR/.aic"
STATE_FILE="$AIC_DIR/state.json"
TASKS_DIR="$AIC_DIR/tasks"
API_URL="${AIC_API_URL:-http://localhost:6868}"
source "$SCRIPT_DIR/api-auth.sh"

cmd="${1:-help}"

case "$cmd" in
  continue)
    if [[ ! -f "$STATE_FILE" ]]; then
      echo "No active state found (.aic/state.json missing)."
      exit 1
    fi
    TASK_ID=$(python3 -c "import json; d=json.load(open('$STATE_FILE')); t=d.get('currentTask'); print(t.get('id') if isinstance(t, dict) else '')" 2>/dev/null)
    if [[ -z "$TASK_ID" ]]; then
      echo "No current task in state.json."
      exit 1
    fi
    TASK_DIR="$TASKS_DIR/$TASK_ID"
    if [[ ! -d "$TASK_DIR" ]]; then
      echo "Task directory not found: $TASK_DIR"
      exit 1
    fi
    echo "=== Resuming $TASK_ID ==="
    read -rp "Resume via Runtime Engine? [y/N] " answer
    if [[ "$answer" =~ ^[Yy] ]]; then
      curl_api -X POST "$API_URL/api/runtime/intent" \
        -H "Content-Type: application/json" \
        -d "{\"intent\":\"task.resume\",\"taskId\":\"$TASK_ID\"}" || true
      echo "Resume intent sent."
    else
      echo "Aborted."
    fi
    ;;
  help|*)
    echo "Usage: aic <command>"
    echo "  continue    Resume interrupted TASK-* via Runtime intent"
    echo "  help        Show this help"
    ;;
esac