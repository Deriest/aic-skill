# AIC Production Configuration
# Copy to .env and fill: cp .env.example .env

# Provider configuration (required)
PROVIDER=aic
API_KEY=your-api-key-here
MODEL_THINKER=Opus
MODEL_CRAFTER=Sonnet
MODEL_SPRINTER=Haiku

# Optional: Dashboard/API URL override
# AIC_API_URL=http://localhost:6868
# DASHBOARD_API_URL=http://localhost:6868

# Optional: CORS origins (comma-separated)
# AIC_CORS_ORIGINS=http://localhost:6969,http://localhost:6868
