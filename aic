#!/usr/bin/env bash
# aic — AIC Engineering Company CLI
# Usage:
#   ./aic setup     — First-time setup (provider, models, git, multi-repo)
#   ./aic update    — Update AIC to latest version
#   ./aic uninstall — Remove AIC completely
#   ./aic test      — Run self-test
#   ./aic help      — Show this help

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SKILL_DIR="${HOME}/.hermes/skills/workflows/aic"
REPO_URL="https://github.com/Deriest/aic-skill.git"

cmd="${1:-help}"
PORT="${2:-6868}"
DASH_PORT="${3:-6969}"

case "$cmd" in
  setup)
    bash "$SKILL_DIR/scripts/setup.sh"
    ;;

  update)
    echo "🔄 Updating AIC..."
    TEMP_DIR=$(mktemp -d)
    git clone --depth 1 "$REPO_URL" "$TEMP_DIR/aic-skill" 2>/dev/null || {
      echo "❌ Failed to clone $REPO_URL"
      rm -rf "$TEMP_DIR"
      exit 1
    }

    # Preserve user config
    ENV_BACKUP=""
    if [[ -f "$SKILL_DIR/.env" ]]; then
      ENV_BACKUP=$(mktemp)
      cp "$SKILL_DIR/.env" "$ENV_BACKUP"
    fi

    # Update skill files (skip .env, status.json, history.json, audit.json)
    cp "$TEMP_DIR/aic-skill/SKILL.md" "$SKILL_DIR/"
    cp -r "$TEMP_DIR/aic-skill/references" "$SKILL_DIR/"
    cp -r "$TEMP_DIR/aic-skill/templates" "$SKILL_DIR/"
    cp -r "$TEMP_DIR/aic-skill/scripts" "$SKILL_DIR/"
    chmod +x "$SKILL_DIR/scripts/"*.sh 2>/dev/null || true

    # Update dashboard if present
    if [[ -f "$TEMP_DIR/aic-skill/dashboard/package.json" ]]; then
      cp -r "$TEMP_DIR/aic-skill/dashboard" "$SKILL_DIR/"
      cd "$SKILL_DIR/dashboard" && npm install --silent 2>/dev/null && cd - > /dev/null
    fi

    # Restore user config
    if [[ -n "$ENV_BACKUP" && -f "$ENV_BACKUP" ]]; then
      cp "$ENV_BACKUP" "$SKILL_DIR/.env"
      rm -f "$ENV_BACKUP"
    fi

    rm -rf "$TEMP_DIR"
    echo "✅ AIC updated!"
    echo "   Skill: $SKILL_DIR"
    echo "   Run: bash $SKILL_DIR/scripts/self-test.sh to verify"
    ;;

  uninstall)
    echo "🗑️  AIC Uninstall"
    echo ""
    echo "This will remove:"
    echo "  1. The AIC skill directory ($SKILL_DIR)"
    echo "  2. opencode.jsonc config (if it points to AIC provider)"
    echo ""
    read -p "Are you sure? [y/N]: " CONFIRM
    if [[ ! "$CONFIRM" =~ ^[Yy] ]]; then
      echo "Cancelled."
      exit 0
    fi

    # Remove skill
    if [[ -d "$SKILL_DIR" ]]; then
      rm -rf "$SKILL_DIR"
      echo "  ✅ Removed $SKILL_DIR"
    fi

    # Remove OpenCode config (only if it contains our provider)
    if [[ -f "$HOME/.config/opencode/opencode.jsonc" ]]; then
      if grep -q "Thinker\|Crafter\|Sprinter" "$HOME/.config/opencode/opencode.jsonc" 2>/dev/null; then
        rm -f "$HOME/.config/opencode/opencode.jsonc"
        echo "  ✅ Removed opencode.jsonc"
      else
        echo "  ⚠️  opencode.jsonc exists but doesn't look like AIC config — skipping"
      fi
    fi

    echo ""
    echo "✅ AIC uninstalled."
    echo "   To reinstall: curl -sSL https://raw.githubusercontent.com/Deriest/aic-skill/main/scripts/setup.sh | bash"
    ;;

  test)
    bash "$SKILL_DIR/scripts/self-test.sh"
    ;;


  stop)
    echo "🛑 Stopping AIC Dispatcher mode in the current terminal..."
    echo "   (Note: The background API server & dashboard are left running for other sessions.)"
    echo "   To stop the background servers completely, use 'killall node vite'."
    echo ""
    echo "   You can now talk to Hermes normally."
    # Since Hermes injects skills based on prompt instructions, 
    # we exit cleanly. The user will type /aic stop in the chat.
    ;;

  help|*)
    echo ""
    echo "🏢 AIC — AI Engineering Company"
    echo ""
    echo "Usage: ./aic <command>"
    echo ""
    echo "Commands:"
    echo "  setup      First-time setup (provider, models, git, multi-repo)"
    echo "  update     Update AIC to latest version"
    echo "  uninstall  Remove AIC completely"
    echo "  test       Run self-test validation"
    echo "  help       Show this help"
    echo ""
    echo "In Hermes, type /aic to activate Dispatcher mode."
    echo ""
    ;;
esac
